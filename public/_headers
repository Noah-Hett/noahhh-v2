# Cloudflare Pages cache rules. Without this file every asset is served
# max-age=0, so each visit revalidates every file.

# Vite output: content-hashed filenames, safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed-name static files: cache for a week, then refresh in the
# background. Rename a file if it must change immediately.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/posters/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/portrait/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/collage/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
